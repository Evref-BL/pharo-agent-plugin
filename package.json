{
  "name": "@evref-bl/pharo-agent",
  "version": "1.2.0",
  "private": false,
  "description": "Live Pharo images for coding agents: PLexus's MCP server and MCP's Pharo skills, as a plugin.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evref-BL/pharo-agent-plugin.git"
  },
  "type": "module",
  "bin": {
    "pharo-agent": "bin/pharo-agent.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    ".mcp.json",
    "plugin.json",
    ".agents",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "skills": "node scripts/build-skills.mjs",
    "package:check": "npm pack --dry-run",
    "pin-readme": "node scripts/pin-readme.mjs"
  },
  "dependencies": {
    "@evref-bl/pharo-mcp": "4.7.0",
    "@evref-bl/plexus": "1.2.1"
  }
}
